// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  PREMIUM
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum TrackVersion {
  FULL_MIX
  UNDERSCORE
  STEMS
  EDIT_60
  EDIT_30
  STING
  LOOP
}

enum Energy {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum LicenseTier {
  FREE
  STANDARD
  PREMIUM
  EXCLUSIVE
}

enum VocalType {
  NONE
  MALE
  FEMALE
  CHOIR
  SPOKEN_WORD
  CHANT
  AD_LIBS_ONLY
}

// ── NextAuth ──────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String   @unique
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── User ──────────────────────────────────────────────────────────────────────

model User {
  id                      String    @id @default(cuid())
  name                    String
  email                   String    @unique
  password                String?
  emailVerifiedDate       DateTime?
  emailVerified           Boolean   @default(false)
  isActive                Boolean   @default(true)
  isVerified              Boolean   @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  image                   String?
  signInToken             String?   @unique
  isRadioStation          Boolean   @default(false)
  role                    UserRole  @default(USER)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  favourites   Favourite[]
  downloads    Download[]
  loginHistory LoginHistory[]
}

// ── Admin ─────────────────────────────────────────────────────────────────────

model Admin {
  id                      String    @id @default(cuid())
  name                    String
  email                   String    @unique
  password                String
  role                    AdminRole @default(ADMIN)
  isActive                Boolean   @default(true)
  isVerified              Boolean   @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model LoginHistory {
  id          String   @id @default(cuid())
  userId      String
  loginMethod String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Music ─────────────────────────────────────────────────────────────────────

model Album {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  genre       String
  composer    String
  coverImage  String
  releaseDate String?
  mood        String[]
  cueSheet    String?
  featured    Boolean  @default(false)
  trackCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tracks Track[]
}

model Track {
  id          String @id @default(cuid())

  // Identity
  title              String
  composer           String
  trackNumber        Int
  duration           Int          // stored in seconds — e.g. 183 for 3:03
  version            TrackVersion @default(FULL_MIX)
  isrc               String?
  releaseDate        String?
  parentTrackId      String?      // reference to full mix if this is an edit or stem

  // Genre, mood & energy
  genre              String
  subGenre           String?
  mood               String[]
  energy             Energy       @default(MEDIUM)
  bpm                Int
  musicalKey         String?

  // Instrumentation
  instruments        String[]
  vocals             VocalType    @default(NONE)
  vocalLanguage      String?
  featuredInstrument String?

  // Usage & licensing
  category           String
  usageTags          String[]
  downloadable       Boolean      @default(false)
  licenseTier        LicenseTier  @default(FREE)
  exclusive          Boolean      @default(false)
  cueSheetUrl        String?

  // Audio & files (Bunny.net URLs)
  audioUrl           String
  previewUrl         String?      // watermarked 30-sec clip for guests
  waveformUrl        String?      // pre-generated waveform PNG for the player
  format             String?      // MP3 · WAV · FLAC
  fileSize           Int?         // bytes
  bitrate            Int?         // kbps

  // Analytics — incremented server-side, never set manually
  playCount          Int          @default(0)
  downloadCount      Int          @default(0)

  // Admin flags
  featured           Boolean      @default(false)
  newRelease         Boolean      @default(false)
  tags               String[]     // free-form keywords for edge cases

  // Timestamps
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  albumId            String
  album              Album        @relation(fields: [albumId], references: [id])
  downloads          Download[]
  favourites         Favourite[]

  // Indexes — these are the fields your filters will hit most
  @@index([albumId])
  @@index([genre])
  @@index([energy])
  @@index([bpm])
  @@index([featured])
  @@index([newRelease])
  @@index([downloadable])
  @@index([category])
}

// ── Playlist ──────────────────────────────────────────────────────────────────

model Playlist {
  id          String   @id @default(cuid())
  name        String
  description String
  coverImage  String?
  coverColor  String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tracks PlaylistTrack[]
}

// Join table — replaces the old trackIds String[] array
// Gives you ordering and lets you query playlist tracks properly
model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int      // order of the track within the playlist
  createdAt  DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
}

// ── User activity ─────────────────────────────────────────────────────────────

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model Download {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}
